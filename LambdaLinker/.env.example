LLM_API_KEY=YOUR_TOKEN
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Thinking
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_TOKENS=
LLM_MAX_RETRIES=

# Feature flags
PRINT_PROMPTS=1
INCLUDE_COMMENTS=1
INCLUDE_IMAGES=1

# MCP (optional)
MCP_WORD_SERVER=
MCP_WORD_CONFIG=/work/helloagent/LambdaEssay/LambdaLinker/mcp-config.json
MCP_WORD_SERVER_NAME=markitdown
USE_MCP=1

# MarkItDown optional (LLM / DocIntel)
MARKITDOWN_LLM_API_KEY=YOUR_TOKEN
MARKITDOWN_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
MARKITDOWN_LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Thinking
MARKITDOWN_LLM_PROMPT=请为文档中的每张图片生成简短中文描述，不要包含文件名/网址/站点名称，只描述图像内容。
MARKITDOWN_DOCINTEL_ENDPOINT=
MARKITDOWN_AZURE_API_KEY=
