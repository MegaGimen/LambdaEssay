LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_ID=qwen-plus
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_TOKENS=
LLM_MAX_RETRIES=

# Feature flags
PRINT_PROMPTS=1
INCLUDE_COMMENTS=1
INCLUDE_IMAGES=1

# MCP (optional) - 暂时禁用，避免配置问题
# MCP_OFFICE_CONFIG=E:\lambaessay_project\LambdaEssay\LambdaLinker\mcp-config.json
# MCP_SERVER_NAME=markitdown
USE_MCP=0

# MarkItDown optional (LLM / DocIntel)
MARKITDOWN_LLM_API_KEY=
MARKITDOWN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MARKITDOWN_LLM_MODEL=qwen-plus
MARKITDOWN_LLM_PROMPT=请为文档中的每张图片生成简短中文描述，不要包含文件名/网址/站点名称，只描述图像内容。
MARKITDOWN_DOCINTEL_ENDPOINT=
MARKITDOWN_AZURE_API_KEY=
