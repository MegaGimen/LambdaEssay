# 主要 LLM 配置（用于文档对比）
LLM_API_KEY=
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL_ID=Qwen/Qwen3-VL-30B-A3B-Instruct
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_TOKENS=
LLM_MAX_RETRIES=

# Feature flags
PRINT_PROMPTS=1
INCLUDE_COMMENTS=1
INCLUDE_IMAGES=1

MCP_OFFICE_CONFIG=D:\helloagent\LambdaEssay\LambdaLinker\mcp-config.json
MCP_SERVER_NAME=markitdown
USE_MCP=1

# MarkItDown 视觉模型配置（使用 ModelScope）
MARKITDOWN_LLM_API_KEY=
MARKITDOWN_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
MARKITDOWN_LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
MARKITDOWN_LLM_PROMPT=请描述这张图片的内容，简洁明了。
MARKITDOWN_DOCINTEL_ENDPOINT=
MARKITDOWN_AZURE_API_KEY=

# cache config
LAMBDALINKER_CACHE_ENABLED=1
LAMBDALINKER_CACHE_DIR=D:\helloagent\LambdaEssay\LambdaLinker\.cache
